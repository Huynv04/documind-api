// DocuMind AI – Prisma Schema
// PostgreSQL + pgvector

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ================================================================
// ENUMS
// ================================================================

enum UserRole {
  EMPLOYEE
  KNOWLEDGE_MANAGER
  ADMIN
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  INDEXED
  FAILED
  ARCHIVED
  DELETED
}

enum SensitivityLevel {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum LlmProvider {
  OPENAI
  GEMINI
  OLLAMA
}

// ================================================================
// MODELS
// ================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?  // null for SSO-only users
  googleId     String?  @unique
  avatar       String?
  role         UserRole @default(EMPLOYEE)
  departmentId String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department?    @relation(fields: [departmentId], references: [id])
  sessions     ChatSession[]
  feedbacks    ChatFeedback[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users     User[]
  documents Document[]

  @@map("departments")
}

model Document {
  id               String           @id @default(uuid())
  originalName     String
  storagePath      String           // Path/key in MinIO or local
  mimeType         String
  sizeBytes        Int
  status           DocumentStatus   @default(UPLOADING)
  sensitivity      SensitivityLevel @default(INTERNAL)
  allowedRoles     UserRole[]       // Which roles can query this document
  departmentId     String?
  uploadedById     String
  errorMessage     String?          // Populated on FAILED
  pageCount        Int?
  retryCount       Int              @default(0)
  processedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  department       Department?      @relation(fields: [departmentId], references: [id])
  tags             DocumentTag[]
  chunks           DocumentChunk[]

  @@map("documents")
}

model DocumentTag {
  id         String   @id @default(uuid())
  documentId String
  tag        String
  createdAt  DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, tag])
  @@map("document_tags")
}

model DocumentChunk {
  id               String           @id @default(uuid())
  documentId       String
  chunkIndex       Int
  content          String           // Raw text of this chunk
  pageNumber       Int?
  tokenCount       Int
  isActive         Boolean          @default(true) // false = soft-deleted
  // Vector stored via raw SQL using pgvector
  // embedding VECTOR(1536) -- created via migration
  createdAt        DateTime         @default(now())

  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id])
  messages  ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(uuid())
  sessionId   String
  role        String   // 'user' | 'assistant'
  content     String
  // Store citations as JSON: [{ documentId, chunkId, pageNumber, excerpt }]
  citations   Json?
  confidence  String?  // 'high' | 'medium' | 'low'
  tokensUsed  Int?
  latencyMs   Int?
  rewrittenQuery String? // The query after rewriting for vector search
  createdAt   DateTime @default(now())

  session     ChatSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  feedbacks   ChatFeedback[]

  @@map("chat_messages")
}

model ChatFeedback {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  isPositive Boolean  // true = Like, false = Dislike
  comment   String?
  createdAt DateTime @default(now())

  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id])

  @@map("chat_feedbacks")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // 'QUERY', 'UPLOAD', 'DELETE', 'LOGIN', etc.
  resourceType String?  // 'DOCUMENT', 'CHAT', 'USER'
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?    // Extra context (query text, document name, etc.)
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id        String      @id @default(uuid())
  key       String      @unique
  value     String
  updatedAt DateTime    @updatedAt

  @@map("system_configs")
}

